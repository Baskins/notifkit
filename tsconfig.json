{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "paths": {
      "@/*": ["./src/*"],
      "notifkit": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "tsdown.config.ts",
    "tsup.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "packages/*/dist"]
}
